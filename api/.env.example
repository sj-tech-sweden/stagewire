# Stagewire API environment configuration (12-factor). Copy to `.env` and adjust.
# All values have safe local defaults; never commit a populated `.env`.

APP_NAME=Stagewire API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8010

# Echo SQL to the logs. Off by default; set to true for local debugging only.
SQL_ECHO=false

# PostgreSQL (async driver). A bare `postgresql://` URI (as CloudNativePG hands out)
# is accepted and normalised to the psycopg3 dialect by Settings. In docker compose
# use host `db`, locally `localhost:5433`.
DATABASE_URL=postgresql+asyncpg://stagewire:stagewire@localhost:5433/stagewire

# Valkey / Redis
REDIS_URL=redis://localhost:6380/0

# CORS — comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:9010

# Stockwire Rental integration (Phase 1)
STOCKWIRE_API_BASE_URL=https://rental-api.sj-tech.se
STOCKWIRE_API_TOKEN=
